PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ORIGIN_ACCESS_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/homelyhub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Optional: enables AI descriptions and the Trip Genie planner.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: enables profile-photo uploads to ImageKit.
IMAGEKIT_PUBLICKEY=
IMAGEKIT_PRIVATEKEY=
IMAGEKIT_URLENDPOINT=

# Optional: enables password-reset email.
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
